<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background: the obsidian face the gold emblem sits on.
  Kept as a vector so it stays sharp on every screen density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF241F31" />
                <item android:offset="0.55" android:color="#FF17141F" />
                <item android:offset="1.0" android:color="#FF0C0A10" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Warm gold bloom in the upper-left, the light source of the emblem. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="26"
                android:centerY="18"
                android:gradientRadius="92"
                android:type="radial">
                <item android:offset="0.0" android:color="#42DCC08C" />
                <item android:offset="1.0" android:color="#00DCC08C" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
